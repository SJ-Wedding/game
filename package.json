{
  "name": "rift-arena",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sim": "vite-node scripts/simulate.ts",
    "test:e2e:full": "FULL_RUN=1 playwright test --grep @long"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.1"
  }
}
